---
interface Props {
  text: string;
  label?: string;
  compact?: boolean;
}

const { text, label = 'Copy prompt', compact = false } = Astro.props;
---
<button class:list={['btn', 'btn--copy', compact && 'btn--small']} type="button" data-copy={text}>
  <svg class="btn__icon" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <rect x="5.25" y="5.25" width="9" height="9" rx="1.6" stroke="currentColor" stroke-width="1.4" />
    <path d="M10.75 2.75H3.4c-.36 0-.65.29-.65.65v7.35" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
  </svg>
  <span class="btn__label" aria-live="polite">{label}</span>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>('.btn--copy').forEach((btn) => {
    if (btn.dataset.bound === 'true') return;
    btn.dataset.bound = 'true';
    const label = btn.querySelector<HTMLElement>('.btn__label');
    const idle = label?.textContent ?? 'Copy prompt';
    let reset: number | undefined;

    const write = async (value: string) => {
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(value);
          return;
        }
      } catch {
        // Permission can be denied even on https. Fall through to the textarea path.
      }
      const field = document.createElement('textarea');
      field.value = value;
      field.setAttribute('readonly', '');
      field.style.cssText = 'position:fixed;top:-1000px;opacity:0';
      document.body.appendChild(field);
      field.select();
      const ok = document.execCommand('copy');
      field.remove();
      if (!ok) throw new Error('copy rejected');
    };

    btn.addEventListener('click', async (event) => {
      event.preventDefault();
      event.stopPropagation();
      let state = 'done';
      try {
        await write(btn.dataset.copy ?? '');
      } catch {
        state = 'failed';
      }
      if (label) label.textContent = state === 'done' ? 'Copied' : 'Press Ctrl+C';
      btn.dataset.state = state;
      window.clearTimeout(reset);
      reset = window.setTimeout(() => {
        if (label) label.textContent = idle;
        delete btn.dataset.state;
      }, 2000);
    });
  });
</script>
