---
import { excerpt, formatDate } from '../lib/prompt';

interface Props {
  title: string;
  image: string;
  category: string;
  slug: string;
  prompt: string;
  date: Date;
}

const { title, image, category, slug, prompt, date } = Astro.props;
---
<a href={`/prompts/${slug}`} class="plate">
  <span class="plate__frame">
    <img class="plate__img" src={image} alt={title} loading="lazy" decoding="async" />
    <span class="plate__peek">{excerpt(prompt, 130)}</span>
  </span>
  <span class="plate__caption">
    <span class="plate__title">{title}</span>
    <span class="plate__meta">{category} · {formatDate(date)}</span>
  </span>
</a>
