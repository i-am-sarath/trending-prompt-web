---
interface Props {
  pageUrl: string;
  mediaUrl: string;
  description: string;
  compact?: boolean;
}

const { pageUrl, mediaUrl, description, compact = false } = Astro.props;
const href = `https://www.pinterest.com/pin/create/button/?url=${encodeURIComponent(pageUrl)}&media=${encodeURIComponent(mediaUrl)}&description=${encodeURIComponent(description)}`;
---
<a
  class:list={['btn', 'btn--pin', compact && 'btn--small']}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
>
  <svg class="btn__icon" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M8 1.75v9.2M4.7 7.4 8 10.95l3.3-3.55" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M3 13.25h10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
  </svg>
  Save<span class="sr-only"> to Pinterest</span>
</a>
