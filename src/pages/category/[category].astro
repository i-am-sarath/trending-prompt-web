---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PromptCard from '../../components/PromptCard.astro';

export async function getStaticPaths() {
  const prompts = await getCollection('prompts');
  const categories = [...new Set(prompts.map((p) => p.data.category))];
  return categories.map((category) => ({
    params: { category },
    props: {
      entries: prompts
        .filter((p) => p.data.category === category)
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { category } = Astro.params;
const { entries } = Astro.props;
---
<BaseLayout
  title={`${category} prompts — trendingprompt`}
  description={`Every ${category} AI image prompt in the trendingprompt archive. Copy any of them in one click.`}
  image={entries[0]?.data.image}
>
  <section class="shell masthead-page">
    <p class="eyebrow">Category</p>
    <h1 class="masthead-page__title">{category}</h1>
  </section>

  <section class="shell section">
    <div class="section__head">
      <h2 class="section__title">{entries.length} {entries.length === 1 ? 'prompt' : 'prompts'}</h2>
      <a class="backlink" href="/"><span aria-hidden="true">←</span> Index</a>
    </div>
    <div class="grid">
      {entries.map((p) => (
        <PromptCard
          title={p.data.title}
          image={p.data.image}
          category={p.data.category}
          slug={p.slug}
          prompt={p.data.prompt}
          date={p.data.date}
        />
      ))}
    </div>
  </section>
</BaseLayout>
