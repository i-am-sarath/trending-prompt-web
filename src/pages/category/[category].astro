---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PromptCard from '../../components/PromptCard.astro';

export async function getStaticPaths() {
  const prompts = await getCollection('prompts');
  const categories = [...new Set(prompts.map((p) => p.data.category))];
  return categories.map((category) => ({
    params: { category },
    props: {
      entries: prompts
        .filter((p) => p.data.category === category)
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { category } = Astro.params;
const { entries } = Astro.props;
---
<BaseLayout title={`${category} prompts — trendingprompt`}>
  <h1>{category}</h1>
  <div class="grid">
    {entries.map((p) => (
      <PromptCard title={p.data.title} image={p.data.image} category={p.data.category} slug={p.slug} />
    ))}
  </div>
</BaseLayout>
