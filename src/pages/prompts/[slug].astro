---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PromptCard from '../../components/PromptCard.astro';
import PromptSpecimen from '../../components/PromptSpecimen.astro';
import { excerpt, formatDate, isoDate } from '../../lib/prompt';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
  const prompts = (await getCollection('prompts'))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return prompts.map((p) => ({
    params: { slug: p.slug },
    props: {
      entry: p,
      related: prompts
        .filter((other) => other.slug !== p.slug && other.data.category === p.data.category)
        .slice(0, 3),
    },
  }));
}

const { entry, related } = Astro.props;
const { title, prompt, image, category, tool, date } = entry.data;
const { Content } = await entry.render();
const hasNotes = entry.body.trim().length > 0;

const url = `${SITE.url}/prompts/${entry.slug}/`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ImageObject',
    name: title,
    description: excerpt(prompt, 200),
    contentUrl: `${SITE.url}${image}`,
    datePublished: isoDate(date),
    ...(tool ? { creditText: tool } : {}),
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: category, item: `${SITE.url}/category/${category}/` },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
];
---
<BaseLayout
  title={`${title} — AI prompt for ${tool ?? 'image generation'}`}
  description={excerpt(prompt, 155)}
  image={image}
  schema={schema}
>
  <article class="shell entry">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="crumbs__sep" aria-hidden="true">/</span>
      <a href={`/category/${category}`}>{category}</a>
      <span class="crumbs__sep" aria-hidden="true">/</span>
      <span class="crumbs__current" aria-current="page">{title}</span>
    </nav>

    <div class="entry__grid">
      <figure class="entry__media rise">
        <div class="plinth">
          <img class="plinth__img" src={image} alt={title} fetchpriority="high" decoding="async" />
        </div>
      </figure>

      <div class="rise" style="--d: 110ms">
        <h1 class="entry__title">{title}</h1>
        <div class="specs">
          <a class="spec spec--link" href={`/category/${category}`}>{category}</a>
          {tool && <span class="spec">{tool}</span>}
          <span class="spec">{formatDate(date)}</span>
        </div>
        <PromptSpecimen prompt={prompt} filename={entry.slug} />

        {hasNotes && (
          <section class="notes">
            <h2 class="notes__label">Notes on this prompt</h2>
            <div class="prose"><Content /></div>
          </section>
        )}
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="shell section">
      <div class="section__head">
        <h2 class="section__title">More in {category}</h2>
        <a class="backlink" href={`/category/${category}`}>See all</a>
      </div>
      <div class="grid">
        {related.map((p) => (
          <PromptCard
            title={p.data.title}
            image={p.data.image}
            category={p.data.category}
            slug={p.slug}
            prompt={p.data.prompt}
            date={p.data.date}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
