---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, readingTime } from '../../lib/prompt';
import { SITE } from '../../lib/site';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const title = 'Prompt guides and AI image craft — trendingprompt blog';
const description =
  'In-depth guides to writing AI image prompts: structure, parameters, lighting, lenses, styles and the trade-offs between Midjourney, DALL·E and Stable Diffusion.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'trendingprompt guides',
    description,
    url: `${SITE.url}/blog/`,
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    blogPost: posts.slice(0, 20).map((post) => ({
      '@type': 'BlogPosting',
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.date.toISOString().slice(0, 10),
      url: `${SITE.url}/blog/${post.slug}/`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: `${SITE.url}/blog/` },
    ],
  },
];
---
<BaseLayout title={title} description={description} schema={schema}>
  <section class="shell page">
    <p class="eyebrow">Guides</p>
    <h1 class="page__title">How to write prompts that work</h1>
    <p class="lede">
      Every prompt in the gallery was written by someone making decisions — about lens, light,
      material, and word order. These guides explain those decisions so you can make them
      yourself instead of copying and hoping.
    </p>
  </section>

  <section class="shell section">
    <div class="section__head">
      <h2 class="section__title">All guides</h2>
      <span class="section__count">{posts.length} {posts.length === 1 ? 'article' : 'articles'}</span>
    </div>

    {posts.length > 0 ? (
      <div class="posts">
        {posts.map((post) => (
          <a class="postrow" href={`/blog/${post.slug}`}>
            <span class="postrow__meta">
              {formatDate(post.data.date)} · {readingTime(post.body)} min
            </span>
            <span>
              <span class="postrow__title">{post.data.title}</span>
              <span class="postrow__dek">{post.data.description}</span>
            </span>
          </a>
        ))}
      </div>
    ) : (
      <p class="empty">No guides published yet.</p>
    )}
  </section>
</BaseLayout>
